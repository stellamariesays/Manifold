# ── Manifold Cloud Environment ──────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Federation hub (the underlying Manifold federation REST API)
FEDERATION_API_URL=http://localhost:8767
FEDERATION_HUB_NAME=trillian

# Redis (usage tracking, rate limit counters, session cache)
REDIS_URL=redis://localhost:6379

# Stripe (leave empty in dev — billing runs in mock mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# Model provider keys (for the router)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Local model endpoint (optional)
LOCAL_MODEL_URL=http://localhost:11434

# Hub manager
HUB_AUTO_SCALE=true
HUB_MAX_INSTANCES=5
HUB_HEALTH_INTERVAL_MS=30000
