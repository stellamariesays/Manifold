{
  "hub": "my-hub",
  "wsUrl": "ws://localhost:8768",
  "defaultTimeoutMs": 60000,
  "agents": [
    {
      "name": "my-openclaw-agent",
      "type": "openclaw",
      "agentId": "main",
      "capabilities": ["execution", "compute", "script-execution", "web-research"],
      "timeout_ms": 120000,
      "maxConcurrency": 3
    },
    {
      "name": "my-script-agent",
      "type": "script",
      "capabilities": ["custom-capability"],
      "script": "examples/quickstart-agent.py",
      "cwd": "/path/to/your/manifold",
      "timeout_ms": 60000
    }
  ]
}
